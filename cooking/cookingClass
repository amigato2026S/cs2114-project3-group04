public class Cooking {

    private Order currentOrder;
    private boolean isBusy;

    /**
     * Initializes the Cooking view with no active order and isBusy set to false.
     */
    public Cooking() {
        this.currentOrder = null;
        this.isBusy = false;
    }

    /**
     * Pulls the highest priority order from the queue, sets it as the active
     * currentOrder, and changes isBusy to true.
     * Handles empty or null queues safely without marking the kitchen busy.
     *
     * @param queue the priority queue of orders
     */
    public void cookNextOrder(PQueue queue) {
        if (queue == null) {
            return;
        }

        // Replace .poll() if your PQueue uses a different method name (e.g., dequeue() or remove())
        Order nextOrder = queue.poll();
        if (nextOrder != null) {
            this.currentOrder = nextOrder;
            this.isBusy = true;
        }
    }

    /**
     * Completes the current order, returns the finished Order object,
     * sets currentOrder to null, and sets isBusy back to false.
     *
     * @return the completed Order, or null if no order was active
     */
    public Order finishOrder() {
        Order finishedOrder = this.currentOrder;
        this.currentOrder = null;
        this.isBusy = false;
        return finishedOrder;
    }

    /**
     * Returns the current boolean value of isBusy to let the system know
     * if the kitchen can take a new order.
     *
     * @return true if currently cooking an order, false otherwise
     */
    public boolean checkStatus() {
        return this.isBusy;
    }

    /**
     * Returns the currently active order (used for display and unit testing).
     *
     * @return the active Order, or null if none
     */
    public Order getCurrentOrder() {
        return this.currentOrder;
    }
}
